# URL base da API REST (back-end Python/FastAPI), usada pelo cliente Axios em src/api/client.ts.
VITE_API_BASE_URL=http://localhost:8080/api

# Mock em memória — seguro por padrão (ver src/config/mockFlag.ts):
# - só liga com o valor exatamente "true", e só em dev (`npm run dev`);
# - ausente ou qualquer outro valor: auth, perfil, catálogo, pedidos e pontos usam a API real;
# - em build de produção o mock nunca liga, mesmo com "true".
# Cadastro de endereços, resgate de pontos e notificações ainda não têm backend: com a API
# real ficam escondidos (ou "Em breve"); só aparecem no modo demonstração.
# Com "true", a tela mostra o aviso "Modo demonstração".
VITE_USE_MOCK=false
