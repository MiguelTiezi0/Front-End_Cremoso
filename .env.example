# URL base da API REST (back-end Spring Boot).
# Quando a API real estiver disponível, defina esta variável e ela será usada
# automaticamente pelo cliente Axios em src/api/client.ts.
VITE_API_BASE_URL=http://localhost:8080/api

# Liga/desliga o mock em memória. Enquanto "true", o front-end funciona sem back-end.
# Mude para "false" (ou remova) quando for consumir a API real.
VITE_USE_MOCK=true
